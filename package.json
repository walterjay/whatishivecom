{
  "name": "whatishive",
  "version": "2.0.0",
  "private": true,
  "description": "whatishive.com: a plain-language explainer of Hive. The site is plain static files in site/; this package only holds the tests.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run validate && node --test \"tests/**/*.test.mjs\"",
    "validate": "html-validate \"site/**/*.html\"",
    "start": "python3 -m http.server 8080 --directory site"
  },
  "devDependencies": {
    "html-validate": "11.16.0",
    "linkedom": "0.18.13"
  }
}
